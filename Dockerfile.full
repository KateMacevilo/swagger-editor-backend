# Multi-stage build: everything (frontend + backend) is built inside Docker.
# Use this on machines without local Node.js / Maven / JDK.
#
#   docker build -f Dockerfile.full -t swagger-editor-backend:1.0.0 .
#   docker run -d --name swagger-editor -p 8080:8080 \
#     -e GITLAB_TOKEN=<PAT> -e GITLAB_PROJECT=<group/project> \
#     swagger-editor-backend:1.0.0
#
# Air-gapped environments: base images are overridable — point them at your
# internal registry / Artifactory proxy, e.g.:
#   docker build -f Dockerfile.full \
#     --build-arg NODE_IMAGE=artifacts.priorbank.by/docker-hub/node:20-bookworm-slim \
#     --build-arg MAVEN_IMAGE=artifacts.priorbank.by/docker-hub/maven:3.9-eclipse-temurin-17 \
#     --build-arg JRE_IMAGE=artifacts.priorbank.by/docker-hub/eclipse-temurin:17-jre \
#     -t swagger-editor-backend:1.0.0 .

# ---- Stage 1: build frontend ----
ARG NODE_IMAGE=node:20-bookworm-slim
ARG MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
ARG JRE_IMAGE=eclipse-temurin:17-jre
FROM ${NODE_IMAGE} AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: build backend JAR (frontend dist lands in static/) ----
FROM ${MAVEN_IMAGE} AS backend
WORKDIR /build
COPY pom.xml ./
COPY src ./src
COPY --from=frontend /build/frontend/dist ./src/main/resources/static
RUN mvn -q package -DskipTests

# ---- Stage 3: runtime ----
FROM ${JRE_IMAGE}
WORKDIR /app
COPY --from=backend /build/target/swagger-editor-backend-1.0.0.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
