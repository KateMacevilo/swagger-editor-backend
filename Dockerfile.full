# Multi-stage build: everything (frontend + backend) is built inside Docker.
# Use this on machines without local Node.js / Maven / JDK.
#
#   docker build -f Dockerfile.full -t swagger-editor-backend:1.0.0 .
#   docker run -d --name swagger-editor -p 8080:8080 \
#     -e GITLAB_TOKEN=<PAT> -e GITLAB_PROJECT=<group/project> \
#     swagger-editor-backend:1.0.0
#
# Air-gapped environments: base images are overridable — point them at your
# internal registry / Artifactory proxy, e.g.:
#   docker build -f Dockerfile.full \
#     --build-arg NODE_IMAGE=artifacts.pr.by/docker-hub/node:20-bookworm-slim \
#     --build-arg MAVEN_IMAGE=artifacts.pr.by/docker-hub/maven:3.9-eclipse-temurin-21 \
#     --build-arg JRE_IMAGE=artifacts.pr.by/docker-hub/eclipse-temurin:21-jre \
#     -t swagger-editor-backend:1.0.0 .

# ---- Stage 1: build frontend ----
ARG NODE_IMAGE=node:20-bookworm-slim
ARG MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
ARG JRE_IMAGE=eclipse-temurin:21-jre
FROM ${NODE_IMAGE} AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
# --engine-strict=false: internal base images may set NPM_CONFIG_ENGINE_STRICT=true (env
# beats .npmrc); the CLI flag has the highest precedence. swagger-client's node>=22
# engines field does not affect our build on node 20.
RUN npm ci --engine-strict=false
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: build backend JAR (frontend dist lands in static/) ----
FROM ${MAVEN_IMAGE} AS backend
WORKDIR /build
COPY pom.xml ./
COPY src ./src
COPY --from=frontend /build/frontend/dist ./src/main/resources/static
RUN mvn -q package -DskipTests

# ---- Stage 3: runtime ----
FROM ${JRE_IMAGE}
WORKDIR /app
# Optional corporate CA certificates: put *.crt files into certs/ before building
# (e.g. certs/prior-ca.crt exported from the browser / provided by IT security).
# They are imported into the JRE truststore so the backend trusts a GitLab
# behind an internal or otherwise untrusted CA (fixes PKIX/SSLHandshake errors).
COPY certs /tmp/certs
RUN for f in /tmp/certs/*.crt; do \
      [ -e "$f" ] || continue; \
      keytool -importcert -trustcacerts -cacerts -storepass changeit -noprompt \
        -alias "$(basename "$f" .crt)" -file "$f"; \
    done
COPY --from=backend /build/target/swagger-editor-backend-1.0.0.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
